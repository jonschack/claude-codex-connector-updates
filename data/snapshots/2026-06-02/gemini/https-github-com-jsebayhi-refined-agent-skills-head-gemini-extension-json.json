{
  "name": "refined-agent-skills",
  "version": "0.3.0",
  "description": "A curated collection of high-signal engineering and professional agent skills distilled from real collaborative sessions.",
  "publisher": "jeremy sebayhi",
  "license": "MIT",
  "contextFileName": "EXTENSION-GEMINI.md",
  "mcpServers": {
    "gitlab": {
      "command": "node",
      "args": [
        "${extensionPath}/skills/interacting-with-gitlab/scripts/server.js"
      ],
      "env": {
        "GITLAB_TOKEN": "$GITLAB_TOKEN"
      }
    },
    "github": {
      "command": "node",
      "args": [
        "${extensionPath}/skills/interacting-with-github/scripts/server.js"
      ],
      "env": {
        "GITHUB_TOKEN": "$GITHUB_TOKEN",
        "GH_TOKEN": "$GH_TOKEN"
      }
    }
  },
  "agents": [
    "agents/adversarial-reviewer.md"
  ]
}
